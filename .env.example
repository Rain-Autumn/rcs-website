RCS_PUBLIC_ORIGIN=http://localhost:3000
RCS_RESEARCH_DIR=./.data/research-publications
# Generate privately with: printf '%s' 'your-password' | node scripts/hash-research-password.mjs
RCS_RESEARCH_PASSWORD_HASH=scrypt$replace-with-generated-value
RCS_TEAM_DIR=./.data/team-members
# Must be different from the Research password.
RCS_TEAM_PASSWORD_HASH=scrypt$replace-with-another-generated-value
