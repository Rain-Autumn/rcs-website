{
  "name": "rcs-website",
  "version": "0.1.0",
  "description": "Public multilingual website for Raiju Cloud System.",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit --passWithNoTests",
    "test:static": "node tests/static-audit.mjs",
    "test:toolchain": "node scripts/check-toolchain.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets:social": "node scripts/generate-social-card.mjs",
    "indexnow:submit": "node scripts/submit-indexnow.mjs",
    "assets:gltf": "gltf-transform optimize"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "clsx": "^2.1.1",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "next": "16.4.5",
    "postprocessing": "^6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@eslint/compat": "^2.1.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-native": "npm:typescript@7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
