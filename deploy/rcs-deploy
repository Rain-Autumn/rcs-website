#!/usr/bin/env bash
set -Eeuo pipefail

readonly SERVICE="raiju-site.service"
readonly APP_ROOT="/var/www/raijucloudsystem.com"
readonly RELEASE_ROOT="${APP_ROOT}/releases"
readonly CURRENT_LINK="${APP_ROOT}/current"
readonly INCOMING_ROOT="/var/lib/rcs-deploy/incoming"
readonly OVERRIDE_DIR="/etc/systemd/system/${SERVICE}.d"
readonly OVERRIDE_FILE="${OVERRIDE_DIR}/zz-github-cd.conf"

fail() {
  printf 'RCS deployment refused: %s\n' "$*" >&2
  exit 1
}

[[ ${EUID} -eq 0 ]] || fail "root privileges are required"
[[ $# -eq 2 ]] || fail "expected an archive path and a commit SHA"

archive="$(realpath -e -- "$1")"
sha="$2"

[[ "$(dirname -- "$archive")" == "$INCOMING_ROOT" ]] || fail "archive is outside the incoming directory"
[[ "$archive" == *.tar.gz ]] || fail "archive extension is invalid"
[[ "$sha" =~ ^[0-9a-f]{40}$ ]] || fail "commit SHA is invalid"
systemctl cat "$SERVICE" >/dev/null || fail "systemd service does not exist"

exec 9>"/run/lock/rcs-deploy.lock"
flock 9

install -d -o root -g root -m 0755 "$APP_ROOT" "$RELEASE_ROOT" "$OVERRIDE_DIR"

release="${RELEASE_ROOT}/${sha}"
staging=""
override_temporary=""
override_backup=""
previous_target=""
had_override=0
switched=0

cleanup() {
  if [[ -n "$staging" && -d "$staging" ]]; then
    rm -rf --one-file-system -- "$staging"
  fi
  if [[ -n "$override_backup" && -f "$override_backup" ]]; then
    rm -f -- "$override_backup"
  fi
  if [[ -n "$override_temporary" && -f "$override_temporary" ]]; then
    rm -f -- "$override_temporary"
  fi
}

set_current_link() {
  local target="$1"
  local temporary_link="${CURRENT_LINK}.new.$$"
  rm -f -- "$temporary_link"
  ln -s -- "$target" "$temporary_link"
  mv -Tf -- "$temporary_link" "$CURRENT_LINK"
}

rollback() {
  trap - ERR
  set +e
  printf 'Health check failed; restoring the previous RCS release.\n' >&2

  if [[ -n "$previous_target" && -d "$previous_target" ]]; then
    set_current_link "$previous_target"
  else
    rm -f -- "$CURRENT_LINK"
  fi

  if [[ "$had_override" -eq 1 && -f "$override_backup" ]]; then
    install -o root -g root -m 0644 "$override_backup" "$OVERRIDE_FILE"
  else
    rm -f -- "$OVERRIDE_FILE"
  fi

  systemctl daemon-reload
  systemctl restart "$SERVICE"
}

on_error() {
  local status=$?
  if [[ "$switched" -eq 1 ]]; then
    rollback
  fi
  cleanup
  exit "$status"
}

trap on_error ERR
trap cleanup EXIT

if [[ -e "$CURRENT_LINK" && ! -L "$CURRENT_LINK" ]]; then
  fail "$CURRENT_LINK exists and is not a symbolic link"
fi

if [[ -L "$CURRENT_LINK" ]]; then
  previous_target="$(readlink -f -- "$CURRENT_LINK")"
fi

if [[ -f "$OVERRIDE_FILE" ]]; then
  override_backup="$(mktemp)"
  cp -- "$OVERRIDE_FILE" "$override_backup"
  had_override=1
fi

if [[ ! -d "$release" ]]; then
  staging="$(mktemp -d "${RELEASE_ROOT}/.${sha}.XXXXXX")"

  while IFS= read -r entry; do
    normalized="${entry#./}"
    [[ "$normalized" != /* ]] || fail "archive contains an absolute path"
    case "/${normalized}/" in
      */../*) fail "archive contains a parent-directory traversal" ;;
    esac
  done < <(tar -tzf "$archive")

  unpacked_bytes="$(tar -tzvf "$archive" | awk '{ total += $3 } END { printf "%.0f", total }')"
  [[ "$unpacked_bytes" =~ ^[0-9]+$ ]] || fail "unable to calculate unpacked size"
  (( unpacked_bytes <= 1610612736 )) || fail "unpacked release exceeds 1.5 GiB"

  tar -xzf "$archive" \
    --directory "$staging" \
    --no-same-owner \
    --no-same-permissions

  [[ -f "$staging/server.js" ]] || fail "standalone server.js is missing"
  [[ -d "$staging/.next/server" ]] || fail "standalone server bundle is missing"
  [[ -d "$staging/.next/static" ]] || fail "static Next.js assets are missing"
  [[ -d "$staging/public" ]] || fail "public assets are missing"

  chown -R debian:debian "$staging"
  chmod 0755 "$staging"
  mv -- "$staging" "$release"
  staging=""
else
  [[ -f "$release/server.js" ]] || fail "existing release is incomplete"
fi

node_bin="$(command -v node)"
[[ -x "$node_bin" ]] || fail "Node.js executable was not found"

override_temporary="$(mktemp "${OVERRIDE_DIR}/.zz-github-cd.XXXXXX")"
cat > "$override_temporary" <<EOF
[Service]
WorkingDirectory=${CURRENT_LINK}
ExecStart=
ExecStart=${node_bin} ${CURRENT_LINK}/server.js
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
EnvironmentFile=-/etc/rcs/rcs.env
EOF
chmod 0644 "$override_temporary"

switched=1
set_current_link "$release"
mv -f -- "$override_temporary" "$OVERRIDE_FILE"
override_temporary=""
systemctl daemon-reload
systemctl restart "$SERVICE"

healthy=0
for _ in $(seq 1 30); do
  if curl --fail --silent --show-error --max-time 3 "http://127.0.0.1:3000/fr" >/dev/null; then
    healthy=1
    break
  fi
  sleep 1
done

[[ "$healthy" -eq 1 ]] || false
switched=0

current_target="$(readlink -f -- "$CURRENT_LINK")"
mapfile -t old_releases < <(
  find "$RELEASE_ROOT" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %f\n' |
    sort -rn |
    tail -n +6 |
    cut -d' ' -f2-
)

for release_name in "${old_releases[@]}"; do
  [[ "$release_name" =~ ^[0-9a-f]{40}$ ]] || continue
  candidate="$(realpath -e -- "${RELEASE_ROOT}/${release_name}")"
  [[ "$candidate" == "${RELEASE_ROOT}/"* ]] || continue
  [[ "$candidate" != "$current_target" ]] || continue
  rm -rf --one-file-system -- "$candidate"
done

printf 'RCS deployment successful: %s\n' "$sha"
